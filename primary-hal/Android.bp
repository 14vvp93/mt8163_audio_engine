cc_library_shared {
    name: "audio.primary.mt8163",
    stem: "audio.primary.mt8163",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "32",
    installable: false,

    srcs: [
        "src/primary_hal.cpp",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
        "-fvisibility=hidden",
    ],
}
